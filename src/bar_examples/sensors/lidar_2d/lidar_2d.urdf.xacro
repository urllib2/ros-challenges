<xacro:unless value="false"
    xmlns:xacro="http://www.ros.org/wiki/xacro">    <!-- Wrapper for namespace -->
    <material name="lidar_material_urdf">        <!-- Corrected from xacro:material -->
        <color rgba="0.3 0.3 0.7 1.0"/>
    </material>
    <xacro:macro name="lidar_2d" params="world_link_name *origin">
        <link name="lidar_2d_link">
            <visual>
                <origin rpy="0 0 1.5707" xyz="0 0 0"/>
                <geometry>
                    <mesh filename="package://sensors/lidar_2d/meshes/lidar_2d_v1.dae"/>
                </geometry>
                <material name="lidar_material_urdf"/>
            </visual>
            <collision name="collision_base">
                <pose xyz="0 0 0.0175015175" rpy="0 0 0"/>
                <geometry>
                    <box size="0.05001062 0.05001062 0.035003035"/>
                </geometry>
            </collision>
            <collision name="collision_top">
                <pose xyz="0 0 0.0525045525" rpy="0 0 0"/>
                <geometry>
                    <cylinder radius="0.02" length="0.035003035"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="0.1"/>
                <origin xyz="0 0 0.025" rpy="0 0 0"/>
                <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
            </inertial>
        </link>
        <gazebo reference="lidar_2d_link">
            <sensor name="lidar_2d_v1" type="gpu_ray">
                <topic>/gz/krytn_lidar/scan</topic>
                <pose xyz="0 0 0.0525045525" rpy="0 0 0"/>
                <ray>
                    <scan>
                        <horizontal>
                            <samples>360</samples>
                            <resolution>1</resolution>
                            <min_angle>-3.14159</min_angle>
                            <max_angle>3.14159</max_angle>
                        </horizontal>
                    </scan>
                    <range>
                        <min>0.10</min>
                        <max>10.0</max>
                        <resolution>0.01</resolution>
                    </range>
                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>0.01</stddev>
                    </noise>
                </ray>
                <always_on>true</always_on>
                <update_rate>10</update_rate>
                <visualize>true</visualize>
            </sensor>
        </gazebo>
        <joint name="lidar_2d_joint" type="fixed">
            <parent link="${world_link_name}"/>
            <child link="lidar_2d_link"/>
            <xacro:insert_block name="origin"/>
        </joint>
    </xacro:macro>
</xacro:unless>