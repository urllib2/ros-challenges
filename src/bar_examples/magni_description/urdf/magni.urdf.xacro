<xacro:macro name="magni_robot_base_definition"
  xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="wheel_r_magni" value="0.1" />
  <xacro:property name="wheel_xpos_magni" value="0.11" />

  <!-- START of pasted content that WAS in inertial.xacro -->
  <xacro:property name="M_PI_inertial" value="3.1415926535897931"/>
  <xacro:macro name="sphere_inertial" params="radius mass">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="${0.4 * mass * radius * radius}" ixy="0.0" ixz="0.0" iyy="${0.4 * mass * radius * radius}" iyz="0.0" izz="${0.4 * mass * radius * radius}"/>
    </inertial>
  </xacro:macro>
  <xacro:macro name="cylinder_inertial" params="radius length mass">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="${0.0833333 * mass * (3 * radius * radius + length * length)}" ixy="0.0" ixz="0.0" iyy="${0.0833333 * mass * (3 * radius * radius + length * length)}" iyz="0.0" izz="${0.5 * mass * radius * radius}"/>
    </inertial>
  </xacro:macro>
  <xacro:macro name="box_inertial" params="x y z mass">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="-0.15 0 0.03"/>
      <inertia ixx="${0.0833333 * mass * (y*y + z*z)}" ixy="0.0" ixz="0.0" iyy="${0.0833333 * mass * (x*x + z*z)}" iyz="0.0" izz="${0.0833333 * mass * (x*x + y*y)}"/>
    </inertial>
  </xacro:macro>
  <xacro:macro name="sphere_inertial_with_origin" params="radius mass *origin">
    <inertial>
      <mass value="${mass}"/>
      <xacro:insert_block name="origin"/>
      <inertia ixx="${0.4 * mass * radius * radius}" ixy="0.0" ixz="0.0" iyy="${0.4 * mass * radius * radius}" iyz="0.0" izz="${0.4 * mass * radius * radius}"/>
    </inertial>
  </xacro:macro>
  <xacro:macro name="cylinder_inertial_with_origin" params="radius length mass *origin">
    <inertial>
      <mass value="${mass}"/>
      <xacro:insert_block name="origin"/>
      <inertia ixx="${0.0833333 * mass * (3 * radius * radius + length * length)}" ixy="0.0" ixz="0.0" iyy="${0.0833333 * mass * (3 * radius * radius + length * length)}" iyz="0.0" izz="${0.5 * mass * radius * radius}"/>
    </inertial>
  </xacro:macro>
  <xacro:macro name="box_inertial_with_origin" params="x y z mass *origin">
    <inertial>
      <mass value="${mass}"/>
      <xacro:insert_block name="origin"/>
      <inertia ixx="${0.0833333 * mass * (y*y + z*z)}" ixy="0.0" ixz="0.0" iyy="${0.0833333 * mass * (x*x + z*z)}" iyz="0.0" izz="${0.0833333 * mass * (x*x + y*y)}"/>
    </inertial>
  </xacro:macro>
  <!-- END of pasted content from inertial.xacro -->

  <xacro:macro name="low_friction_magni_internal">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>0.1</mu>
            <mu2>0.1</mu2>
            <slip1>0</slip1>
            <slip2>0</slip2>
          </ode>
        </friction>
      </surface>
      <max_contacts>1</max_contacts>
    </collision>
  </xacro:macro>
  <xacro:macro name="high_friction_magni_internal">
    <collision>
      <surface>
        <friction>
          <ode>
            <mu>1.0</mu>
            <mu2>1.0</mu2>
            <fdir1>0 0 1</fdir1>
            <slip1>0.0</slip1>
            <slip2>0.0</slip2>
          </ode>
        </friction>
      </surface>
      <max_contacts>1</max_contacts>
    </collision>
  </xacro:macro>

  <link name="base_link">
    <visual>
      <origin xyz="${-wheel_xpos_magni} 0 ${-wheel_r_magni+0.071}" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://magni_description/meshes/magni_body.dae" />
      </geometry>
      <material name="magni_grey_material"/>
    </visual>
    <collision>
      <origin xyz="${-wheel_xpos_magni} 0 ${-wheel_r_magni+0.151}" rpy="0 0 0" />
      <geometry>
        <box size="0.398 0.268 0.160"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="${-wheel_xpos_magni-0.026} 0 ${-wheel_r_magni+0.248}" rpy="0 0 0" />
      <geometry>
        <box size="0.375 0.268 0.034"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="${-wheel_xpos_magni-0.169} 0.169 ${-wheel_r_magni+0.106}" rpy="0 0 0" />
      <geometry>
        <box size="0.1 0.07 0.07"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="${-wheel_xpos_magni-0.169} -0.169 ${-wheel_r_magni+0.106}" rpy="0 0 0" />
      <geometry>
        <box size="0.1 0.07 0.07"/>
      </geometry>
    </collision>
    <xacro:box_inertial_with_origin x="0.398" y="0.221" z="0.150" mass="10.0">
      <origin xyz="-0.15 0 0.03" rpy="0 0 0" />
    </xacro:box_inertial_with_origin>
  </link>
  <gazebo reference="base_link">
    <xacro:low_friction_magni_internal/>
  </gazebo>

  <xacro:macro name="magni_wheel_internal" params="prefix reflect">
    <link name="${prefix}_wheel_link">
      <collision>
        <origin xyz="${0.033*reflect} 0 0" rpy="0 ${M_PI_inertial/2} 0" />
        <geometry>
          <cylinder radius="${wheel_r_magni}" length="0.01"/>
        </geometry>
      </collision>
      <visual>
        <origin xyz="${-0.071*reflect} 0 0" rpy="0 ${(reflect-1)*M_PI_inertial/2} 0" />
        <geometry>
          <mesh filename="package://magni_description/meshes/front_wheel.dae" />
        </geometry>
        <material name="magni_black_material"/>
      </visual>
      <xacro:cylinder_inertial_with_origin radius="${wheel_r_magni}" length="0.05" mass="1.34">
        <origin xyz="0 0 0" rpy="0 ${M_PI_inertial/2} 0" />
      </xacro:cylinder_inertial_with_origin>
    </link>
    <joint name="${prefix}_wheel_joint" type="continuous">
      <axis xyz="1 0 0" rpy="0 0 0" />
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="0 ${0.163*reflect} 0" rpy="0 0 ${M_PI_inertial/2}"/>
      <dynamics damping="0.2" friction="0.8"/>
      <limit effort="1000" velocity="10"/>
    </joint>
    <gazebo reference="${prefix}_wheel_link">
      <xacro:high_friction_magni_internal/>
    </gazebo>
  </xacro:macro>
  <xacro:magni_wheel_internal prefix="left" reflect="1"/>
  <xacro:magni_wheel_internal prefix="right" reflect="-1"/>

  <xacro:macro name="magni_caster_wheel_internal" params="prefix reflect">
    <link name="${prefix}_caster_wheel_link">
      <collision>
        <origin xyz="${-0.27 + (0.37 - 0.27)} ${reflect*0.169} ${-wheel_r_magni+0.04}" rpy="0 0 0" />
        <geometry>
          <sphere radius="0.04"/>
        </geometry>
      </collision>
      <visual>
        <origin xyz="${-0.25 + (0.37 - 0.25)} ${reflect*0.169} 0" rpy="0 0 ${M_PI_inertial}" />
        <geometry>
          <mesh filename="package://magni_description/meshes/caster_wheel.dae" />
        </geometry>
        <material name="magni_black_material"/>
      </visual>
      <inertial>
        <mass value="0.1"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>
    <joint name="${prefix}_caster_wheel_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${prefix}_caster_wheel_link"/>
      <origin xyz="-0.37 ${reflect*0.169} ${-wheel_r_magni+0.04}" rpy="0 0 0" />
    </joint>
    <gazebo reference="${prefix}_caster_wheel_link">
      <xacro:low_friction_magni_internal/>
    </gazebo>
  </xacro:macro>
  <xacro:magni_caster_wheel_internal prefix="left" reflect="1"/>
  <xacro:magni_caster_wheel_internal prefix="right" reflect="-1"/>

  <material name="magni_grey_material">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>
  <material name="magni_black_material">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
</xacro:macro>